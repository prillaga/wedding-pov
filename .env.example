# Public URL for QR codes & share links (required for correct guest QR codes)
NEXT_PUBLIC_APP_URL=https://wedding-pov-by-prillaga-co.vercel.app

# Vercel KV / Upstash (optional — syncs custom events across guest devices)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (auto-added when you connect a Blob store — syncs events across devices)
BLOB_READ_WRITE_TOKEN=

# Supabase (optional — PostgreSQL + Storage for production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase (optional — legacy stub)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
