# Public URL for QR codes & share links (required for correct guest QR codes)
NEXT_PUBLIC_APP_URL=https://wedding-pov-two.vercel.app

# Vercel KV / Upstash (optional — syncs custom events across guest devices)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (auto-added when you connect a Blob store — syncs events across devices)
BLOB_READ_WRITE_TOKEN=

# Firebase (optional — enables cloud sync when configured)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
